# Copie este arquivo para terraform.tfvars e preencha os valores

region       = "us-east-1"
project_name = "dyno-agent"
db_password  = "dyno_pass"

# API Keys
huggingface_token = ""
gemini_api_key    = ""
jwt_secret        = ""

# Backup Configuration
# Important: AWS Free Tier requires backup_retention_days = 0
# If you're on a paid tier, use 7-30 days
backup_retention_days = 0  # Free tier: must be 0. Paid tier: 7-30
backup_window         = "03:00-04:00"
maintenance_window    = "sun:04:00-sun:05:00"